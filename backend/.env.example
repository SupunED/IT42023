# Application
PORT=5000
NODE_ENV=development
SESSION_SECRET=
APP_ORIGINS=http://localhost:5173,http://localhost:5000

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Database (MySQL / XAMPP)
DB_NAME=booknest_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_SSL=false

# Azure Storage Account (Blob Storage for Book Covers & Avatars)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=bookneststorage;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=booknest-media

# Azure Communication Services (Transactional Emails)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://booknest-email.unitedstates.communication.azure.com/;accesskey=your_access_key
AZURE_EMAIL_SENDER=DoNotReply@booknest-store.azurecomm.net

# Fallback SMTP Settings (Optional)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
